local MainTab = Window:CreateTab("Main", 0)

local espActive = true
local bindedActive = false
local currentBind = Enum.KeyCode.E
local bindPressed = false
local espBoxes = {}

local ESPSection = MainTab:CreateSection("ESP")

local BoxESPToggle = MainTab:CreateToggle({
	Name = "Box ESP",
	CurrentValue = true,
	Flag = "BoxESP",
	Callback = function(Value)
		espActive = Value
		if not espActive then
			for userId, boxData in pairs(espBoxes) do
				boxData:Destroy()
			end
			espBoxes = {}
		end
	end,
})

local BindedToggle = MainTab:CreateToggle({
	Name = "Binded",
	CurrentValue = false,
	Flag = "Binded",
	Callback = function(Value)
		bindedActive = Value
	end,
})

local BindButton = MainTab:CreateButton({
	Name = "Bind: E",
	Callback = function()
		Rayfield:Notify({
			Title = "Bind",
			Content = "Press any key to bind...",
			Duration = 2,
		})
		
		local inputService = game:GetService("UserInputService")
		local connection
		connection = inputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				currentBind = input.KeyCode
				BindButton:Set("Bind: " .. tostring(currentBind):gsub("Enum.KeyCode.", ""))
				connection:Disconnect()
			end
		end)
	end,
})

local inputService = game:GetService("UserInputService")
inputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == currentBind and not gameProcessed then
		bindPressed = not bindPressed
	end
end)

task.spawn(function()
	while true do
		if espActive then
			local players = game:GetService("Players")
			local camera = workspace.CurrentCamera
			
			local shouldDraw = true
			if bindedActive then
				shouldDraw = bindPressed
			end
			
			for _, player in pairs(players:GetPlayers()) do
				if player ~= players.LocalPlayer and player.Character then
					local hrp = player.Character:FindFirstChild("HumanoidRootPart")
					if hrp then
						local displayName = player.DisplayName or player.Name
						
						if not espBoxes[player.UserId] then
							local screenGui = Instance.new("ScreenGui")
							screenGui.Name = "ESPBox_" .. player.UserId
							screenGui.ResetOnSpawn = false
							screenGui.Parent = game:GetService("CoreGui")
							
							local box = Instance.new("Frame")
							box.Name = "Box"
							box.BackgroundTransparency = 1
							box.BorderColor3 = Color3.fromRGB(255, 0, 0)
							box.BorderSizePixel = 2
							box.Parent = screenGui
							
							local nameLabel = Instance.new("TextLabel")
							nameLabel.Name = "NameLabel"
							nameLabel.BackgroundTransparency = 1
							nameLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
							nameLabel.TextSize = 14
							nameLabel.Text = displayName
							nameLabel.Parent = box
							nameLabel.Position = UDim2.new(0, 0, 0, -20)
							nameLabel.Size = UDim2.new(1, 0, 0, 20)
							
							espBoxes[player.UserId] = screenGui
						end
						
						local screenGui = espBoxes[player.UserId]
						screenGui.Enabled = shouldDraw
						
						if shouldDraw then
							local screenPos, onScreen = camera:WorldToScreenPoint(hrp.Position)
							
							if onScreen then
								local distance = (camera.Focus.Position - hrp.Position).Magnitude
								local boxSize = math.max(40, 200 / math.max(distance / 10, 0.1))
								
								local box = screenGui:FindFirstChild("Box")
								box.Size = UDim2.new(0, boxSize, 0, boxSize)
								box.Position = UDim2.new(0, screenPos.X - boxSize / 2, 0, screenPos.Y - boxSize / 2)
							end
						end
					end
				end
			end
			
			for userId, screenGui in pairs(espBoxes) do
				if not players:FindFirstChild(tostring(userId)) then
					screenGui:Destroy()
					espBoxes[userId] = nil
				end
			end
		end
		
		wait(0.016)
	end
end)

