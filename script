local ESPTab = Window:CreateTab("ESP", 0)

local boxESPActive = false
local players = game:GetService("Players")
local espedPlayers = {}

local function getRainbowColor(hue)
	return Color3.fromHSV(hue % 1, 1, 1)
end

local function addPlayerESP(player)
	if player == players.LocalPlayer then return end
	if not player.Character then return end
	
	if not espedPlayers[player] then
		esplib.add_box(player.Character)
		esplib.add_name(player.Character)
		esplib.add_distance(player.Character)
		espedPlayers[player] = true
	end
end

local function removePlayerESP(player)
	espedPlayers[player] = nil
end

local BoxESPToggle = ESPTab:CreateToggle({
	Name = "Box ESP",
	CurrentValue = false,
	Flag = "BoxESP",
	Callback = function(Value)
		boxESPActive = Value
		esplib.box.enabled = Value
		esplib.name.enabled = Value
		esplib.distance.enabled = Value
		
		if boxESPActive then
			for _, player in pairs(players:GetPlayers()) do
				addPlayerESP(player)
			end
		end
	end,
})

players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		if boxESPActive then
			addPlayerESP(player)
		end
	end)
	
	if player.Character and boxESPActive then
		addPlayerESP(player)
	end
end)

players.PlayerRemoving:Connect(function(player)
	removePlayerESP(player)
end)

task.spawn(function()
	local hue = 0
	while true do
		esplib.box.fill = getRainbowColor(hue)
		esplib.name.fill = getRainbowColor(hue)
		esplib.distance.fill = getRainbowColor(hue)
		hue = hue + 0.002
		wait(0.016)
	end
end)

